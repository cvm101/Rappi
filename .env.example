# Copy to .env and fill in. .env is git-ignored.

# --- Database ---
# Leave SUPABASE_DB_URL empty to run on in-memory H2 (zero setup).
#
# IMPORTANT: use the SESSION POOLER string, not the "Direct connection" one.
# The direct host (db.<project-ref>.supabase.co) is IPv6-only and fails to resolve
# on IPv4-only networks (common for home/office Wi-Fi). The pooler is IPv4-safe.
# Supabase: Project Settings -> Database -> Connection string -> Session pooler (JDBC)
# e.g. jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
# Note the pooler username includes the project ref: postgres.<project-ref>
SUPABASE_DB_URL=
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=

# --- LLM ---
# mock   = deterministic scripted policy (no key needed, used by tests)
# openai = any OpenAI-compatible chat-completions API with tool calling
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# mock only: make the first attempt naive (blindly accept the recommendation)
# to demonstrate the validate -> revise feedback loop
LLM_MOCK_NAIVE_FIRST=false
